# Copiar para .env e preencher os valores

# Caminho para a base de dados SQLite
DATABASE_URL="file:../storage/cadastro.db"

# Segredo para assinar os cookies de sessão (usar valor longo e aleatório em produção)
AUTH_SECRET="alterar-para-um-valor-longo-e-aleatorio"

# Definir como "true" APENAS quando HTTPS estiver configurado.
# Em HTTP (rede interna sem HTTPS) deixar como "false" ou não definir.
COOKIE_SECURE="false"
